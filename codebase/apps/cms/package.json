{
  "name": "cms",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "db:export:default": "node ./scripts/export-current-db.mjs",
    "db:import:default": "node ./scripts/import-default-db.mjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "sonar:scan:old": "npx sonar-scanner",
    "sonar:scan": "sonar -Dsonar.host.url=http://localhost:9000 -Dsonar.token=sqp_df3a497ae9e69084cabe392218873a149a48207b -Dsonar.projectKey=weeby-local",
    "sonar:scan:docker": "docker compose up -d sonardb sonarqube && docker compose --profile sonar-scan run --rm --no-deps scanner",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "npm run test:int",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@payloadcms/next": "3.84.1",
    "@payloadcms/richtext-lexical": "3.84.1",
    "@payloadcms/ui": "3.84.1",
    "@payloadcms/db-postgres": "3.84.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "payload": "3.84.1",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@vitejs/plugin-react": "4.5.2",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.21.0",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  }
}
